{
  "name": "@pidgin/codec",
  "version": "1.0.3",
  "description": "JavaScript/TypeScript client decoder for Pidgin SchemaCodec binary wire format",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/fixtures.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "keywords": [
    "pidgin",
    "schema",
    "codec",
    "binary",
    "decoder",
    "compression"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
